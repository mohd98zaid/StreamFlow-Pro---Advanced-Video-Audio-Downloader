{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StreamFlow Pro",
  "version": "3.0.0",
  "identifier": "com.streamflow.pro",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm.cmd run dev --prefix frontend",
    "beforeBuildCommand": "npm.cmd run build --prefix frontend"
  },
  "app": {
    "windows": [
      {
        "title": "StreamFlow Pro",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
